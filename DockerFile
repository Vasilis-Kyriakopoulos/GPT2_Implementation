FROM python:3.12-slim
COPY . /app
WORKDIR /app
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirements_cpu.txt && \
    python -m pip install -r requirements.txt && \
    python -c "import pathspec, pathspec.patterns.gitwildmatch as g; print('pathspec', pathspec.__version__); assert hasattr(g, '_DIR_MARK')"
ENV GIT_PYTHON_REFRESH=quiet
CMD  python -m pytest -q && python -m dvc pull models/champion/trained_model.pt && python -m dvc pull models/champion/metrics.json && python -m dvc pull models/champion/config.yaml && python -m dvc pull data/wikitext-test.txt \
     && python -m src.training.evaluate --model-path models/champion/trained_model.pt --output-path models/champion/metrics.json --config-path models/champion/config.yaml
